# ==============================================================================
# Cloud Native Runtime Protection & API Security Framework
# Environment Configuration Template (.env.example)
# ==============================================================================

# Database (PostgreSQL) Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mobile_security_db
POSTGRES_USER=secops_admin
POSTGRES_PASSWORD=SecOps_Production_Password_ChangeMe123!

# Cache & Rate Limiting (Redis) Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Configuration
# Key must be at least 256 bits (32 bytes) base64-encoded for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=cloud-native-security-framework

# Service Network URLs
GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
BUSINESS_SERVICE_URL=http://business-service:8083
THREAT_DETECTION_URL=http://threat-detection-service:8084
AUDIT_LOGGING_URL=http://audit-logging-service:8085

# Cross-Origin Resource Sharing (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting Policies (Requests Per Minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100
RATE_LIMIT_SECURITY_EVENTS=20

# Centralized Logging (ELK Stack)
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044
KIBANA_PORT=5601

# Monitoring & Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Grafana_Admin_Secure123!

# Mobile Framework Runtime Security Defaults
RUNTIME_PROTECTION_ENABLED=true
ROOT_DETECTION_ENABLED=true
JAILBREAK_DETECTION_ENABLED=true
DEBUGGER_DETECTION_ENABLED=true
FRIDA_DETECTION_ENABLED=true
INTEGRITY_CHECK_ENABLED=true
CERTIFICATE_PINNING_ENABLED=true
BIOMETRIC_ENABLED=true
RISK_THRESHOLD=MEDIUM
SESSION_TIMEOUT_SECONDS=900

{
  "source": "mockoon:cli",
  "data": [
    {
      "type": "environment",
      "item": {
        "name": "AppShieldX Core Gateway",   
        "port": 8080,
        "hostname": "0.0.0.0",
        "routes": [
          {
            "method": "post",
            "endpoint": "v1/telemetry",
            "responses": [
              {
                "statusCode": 403,
                "label": "Block Compromised Environments",
                "body": "{\n  \"error\": \"ENVIRONMENT_UNTRUSTED\",\n  \"message\": \"Security Policy Violation: Malicious runtime modifications intercepted.\"\n}",
                "headers": [{ "key": "Content-Type", "value": "application/json" }],
                "rules": [
                  {
                    "target": "body",
                    "property": "",
                    "invert": false,
                    "operator": "regex",
                    "value": "\"integrityStatus\"\\s*:\\s*\"COMPROMISED\""
                  }
                ]
              },
              {
                "statusCode": 200,
                "label": "Allow Verified Environment Passes",
                "body": "{\n  \"status\": \"SUCCESS\",\n  \"message\": \"Telemetry ingestion accepted.\"\n}",
                "headers": [{ "key": "Content-Type", "value": "application/json" }],
                "rules": []
              }
            ]
          },
          {
            "method": "get",
            "endpoint": "v1/status",
            "responses": [
              {
                "statusCode": 200,
                "body": "{\n  \"gateway\": \"ONLINE\",\n  \"serviceMesh\": \"ACTIVE\"\n}",
                "headers": [{ "key": "Content-Type", "value": "application/json" }]
              }
            ]
          }
        ]
      }
    }
  ]
}
      "id": 6,
      "title": "Zero-Trust Gateway PEP (:8080)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "probe_success{instance=\"http://localhost:8080/actuator/health\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "HEALTHY (4.2ms)", "color": "green" } } }],
